# Copy to .env and change what you need. .env is ignored by Git.

# Postgres credentials of the local stack (compose.yaml). The defaults work as they are.
DB_USER=atletico
DB_PASS=atletico
DB_DATABASE=atletico

# Set to 1 when the web app does not reload on file changes (some Docker hosts do not pass file events).
VITE_POLLING=

# The session cookie carries the Secure flag by default. compose.yaml sets it to false for the local stack,
# which runs on plain HTTP. Leave it true on any deployment served over HTTPS.
AUTH_COOKIE_SECURE=true
